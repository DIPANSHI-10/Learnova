# Copy this file to .env at the project root and replace every value marked CHANGE_ME.
# Do not commit your real .env file.

NODE_ENV=development
DATABASE_URL=mysql://novamind_user:CHANGE_ME@127.0.0.1:3306/novamind_ai
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_OR_LONGER_VALUE

# Enables the intentionally local-only user and filesystem storage adapter.
LOCAL_DEV_BYPASS_AUTH=true
LOCAL_DEV_USER_OPEN_ID=local-dev-user
LOCAL_DEV_USER_NAME=Your Name
LOCAL_DEV_USER_EMAIL=you@example.local
VITE_LOCAL_DEV_BYPASS_AUTH=true

# These placeholder values prevent the hosted OAuth settings from being used in local developer mode.
OAUTH_SERVER_URL=http://localhost:3000
VITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=local-novamind

# Leave these blank for local fallback AI and local file storage.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
